# MinIO object storage
MINIO_ROOT_USER=nowcpi
MINIO_ROOT_PASSWORD=change-this-minio-password
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=lakehouse

# MariaDB metadata store for Hive Metastore
MARIADB_ROOT_PASSWORD=change-this-db-root-password
MARIADB_DATABASE=metastore_db
MARIADB_USER=nowcpi_metastore
MARIADB_PASSWORD=change-this-metastore-password

# Spark worker resources
SPARK_WORKER_MEMORY=2G
SPARK_WORKER_CORES=2
